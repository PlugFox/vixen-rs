{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.chat_id,\n            c.slug,\n            ci.title         AS \"title?\",\n            ci.type          AS \"kind?\",\n            ci.members_count AS \"members_count?\"\n        FROM chats c\n        LEFT JOIN chat_info_cache ci ON ci.chat_id = c.chat_id\n        WHERE c.chat_id = ANY($1)\n        ORDER BY c.chat_id\n        ",
